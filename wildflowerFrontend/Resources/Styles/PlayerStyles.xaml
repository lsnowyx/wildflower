<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Style x:Key="PlayerPageStyle" TargetType="ContentPage">
        <Setter Property="BackgroundColor" Value="{StaticResource PlayerBackground}" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style x:Key="PrimaryLabel" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource PlayerPrimaryText}" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
    </Style>

    <Style x:Key="SecondaryLabel" TargetType="Label" BasedOn="{StaticResource PrimaryLabel}">
        <Setter Property="TextColor" Value="{StaticResource PlayerSecondaryText}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style x:Key="SectionLabel" TargetType="Label" BasedOn="{StaticResource SecondaryLabel}">
        <Setter Property="CharacterSpacing" Value="2.2" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="11" />
    </Style>

    <Style x:Key="AngularActionBorder" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource PlayerSecondarySurface}" />
        <Setter Property="Stroke" Value="{StaticResource PlayerDivider}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 2" />
        <Setter Property="Padding" Value="13,9" />
    </Style>

    <Style x:Key="AngularActionLabel" TargetType="Label" BasedOn="{StaticResource PrimaryLabel}">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="CharacterSpacing" Value="1.3" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
    </Style>

    <Style x:Key="TrackRowBorder" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource PlayerRaisedSurface}" />
        <Setter Property="Stroke" Value="{StaticResource PlayerDivider}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="Rectangle" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="Margin" Value="0,2,8,2" />
    </Style>

    <Style x:Key="PlayerSlider" TargetType="Slider">
        <Setter Property="MinimumTrackColor" Value="{StaticResource PlayerAccent}" />
        <Setter Property="MaximumTrackColor" Value="{StaticResource PlayerDivider}" />
        <Setter Property="ThumbColor" Value="{StaticResource PlayerAccent}" />
    </Style>

    <Style x:Key="StatusMessageLabel" TargetType="Label" BasedOn="{StaticResource SectionLabel}">
        <Setter Property="TextColor" Value="{StaticResource PlayerSecondaryText}" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
    </Style>
</ResourceDictionary>
